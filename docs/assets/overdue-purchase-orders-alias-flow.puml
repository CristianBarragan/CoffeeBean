@startuml overdue-purchase-orders-alias-flow
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #55506A
skinparam activity {
  FontSize 15
  FontColor #17132B
  BorderThickness 1.5
  BackgroundColor #FFFFFF
  BorderColor #55506A
  DiamondBackgroundColor #FFF9EE
  DiamondBorderColor #D78A18
}
skinparam titleFontSize 20
skinparam titleFontColor #17132B
skinparam noteBackgroundColor #F8F7FC
skinparam noteBorderColor #AAA6BA

title Foundgine — Alias-Matched Request Through the Semantic Execution Boundary\nSame canonical meaning, two different sentences

start
partition "1-2. Caller intent -> Intent representation" #F3EFFF {
  :Caller intent;
  note right
    Canonical: "show me overdue purchase orders
    from our top supplier in Texas"

    Paraphrase: "show me the overdue buys
    from our top seller in Texas"

    Neither sentence contains SQL or
    provider instructions.
  end note
  :Intent representation;
}
partition "3-4. Semantic Model -> Operation Graph" #EDEBFB {
  :Semantic Model + generated aliases;
  note right
    PurchaseOrder <- Buy, Buys
    Supplier <- Vendor, Seller
  end note
  :Semantic Operation Graph;
  note right
    overdue -> PurchaseOrder status/date semantics
    buys -> PurchaseOrder
    seller -> Supplier
    top supplier -> ranked supplier candidate set
    Texas -> state constraint
  end note
}
partition "5. Retrieval (advisory)" #FFF5E8 {
  :Retrieval / candidate discovery;
  note right
    Relational, fuzzy/full-text, BM25/search,
    or graph strategies supply candidates
    and evidence. They do not grant authority.
  end note
}
partition "6. Semantic Resolution" #EEF9EF {
  :Semantic Resolution;
  note right
    "buys" -> PurchaseOrder
    "seller" -> Supplier

    Aliases normalize to the same canonical
    identities as the original wording --
    both sentences now share one meaning.
  end note
}
partition "7-9. Authorization -> Plan Binding -> ExecutionIR" #F0F5FF {
  :Authorization;
  note right
    Application policy is evaluated against
    the resolved semantic graph and caller
    identity. Retrieval cannot bypass this step.
  end note
  :Plan Binding;
  :ExecutionIR;
  note right
    Authorization provenance and the resolved
    semantic graph are carried into the
    executable artifact.
  end note
}
partition "10-11. Provider -> Execution" #FCEAF2 {
  :Provider conformance;
  :PostgreSQL execution;
  note right
    The provider executes the constrained
    plan rather than reinterpreting
    caller vocabulary.
  end note
}
partition "12. Evidence" #FDF1E4 {
  :Result + Evidence;
  note right
    Evidence records what was resolved
    and executed. It does not grant authority.
  end note
}
stop
@enduml
