@startuml lexical-grounding-clarification-flow
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #55506A
skinparam activity {
  FontSize 15
  FontColor #17132B
  BorderThickness 1.5
  BackgroundColor #FFFFFF
  BorderColor #55506A
}
skinparam titleFontSize 20
skinparam titleFontColor #17132B
skinparam noteBackgroundColor #F8F7FC
skinparam noteBorderColor #AAA6BA

title Foundgine — Lexical Grounding When More Than One Meaning Is Legal\n"active customers": fuzzy retrieval returns two tied, competing meanings

start
partition "Free-form language" #F3EFFF {
  :"active customers";
  :Tokenization;
}
partition "Retrieval (advisory, fuzzy / BM25 / vector)" #FFF5E8 {
  :Candidate retrieval for "active";
  note right
    Two structurally different fields
    both come back as plausible:

    "active" -> Customer.AccountEnabled
    (score 0.91)
    "active" -> Customer.HasRecentOrder
    (score 0.89)

    Retrieval score alone cannot
    break this tie.
  end note
  :Ranked lexical candidates;
}
partition "Graph-constrained resolution" #EEF9EF {
  :Every candidate is checked\nagainst the semantic contract;
  :Both candidates form a\nvalid, legal path;
  note right
    A legal path is evidence an
    interpretation is *possible*,
    not evidence it is *intended*.

    The two paths carry different
    signatures: same token, different
    field. Neither dominates on
    confidence.
  end note
}
partition "Grounding decision (Ground)" #EDEBFB {
  :GroundingOutcome.RequiresClarification;
  :Committed = null;
  :CompetingInterpretations =\n[AccountEnabled, HasRecentOrder];
  note right
    Each competing interpretation keeps
    its own steps, confidence and
    lexical evidence -- not just a
    runner-up score.
  end note
}
partition "Caller chooses" #FCEAF2 {
  :Surface the competing meanings\nas a clarifying question;
  note right
    "Did you mean customers with an
    enabled account, or customers
    with a recent order?"
  end note
  :Caller selects one interpretation;
  :Selected interpretation becomes\nthe grounded meaning;
}
partition "Same boundary as every other request" #F0F5FF {
  :Authorization;
  :Planning / execution;
}
stop
@enduml
