@startuml lexical-grounding-flow
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #55506A
skinparam activity {
  FontSize 15
  FontColor #17132B
  BorderThickness 1.5
  BackgroundColor #FFFFFF
  BorderColor #55506A
}
skinparam titleFontSize 20
skinparam titleFontColor #17132B

title Foundgine — Lexical Grounding\nApproximate retrieval proposes candidates; the semantic contract stays authoritative

start
partition "Free-form language" #F3EFFF {
  :Natural language input;
  :Tokenization;
}
partition "Retrieval (advisory)" #FFF5E8 {
  :Candidate retrieval\n(every token x semantic kind\nvia ISemanticLexicalCandidateSource);
  :Ranked lexical candidates;
}
partition "Graph-constrained resolution" #EEF9EF {
  :Start from the highest-scoring\nremaining candidate;
  repeat
    :Semantic-contract validation;
    :Neighbour-constrained graph walk;
  repeat while (Candidate cannot form\na valid path?) is (yes: backtrack to\nnext candidate) not (no)
  :Canonical semantic interpretation;
}
partition "Same boundary as every other caller" #F0F5FF {
  :Authorization;
  :Planning / execution;
}
stop
@enduml
