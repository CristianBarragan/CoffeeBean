<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Everything the 5-project version needed, in one place. -->
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Foundgine.Abstractions/Foundgine.Abstractions.csproj" />
    <ProjectReference Include="../../../src/Foundgine.Aot/Foundgine.Aot.csproj" />
    <ProjectReference Include="../../../src/Foundgine.Metadata/Foundgine.Metadata.csproj" />
    <ProjectReference Include="../../../src/Foundgine.Planning/Foundgine.Planning.csproj" />
    <ProjectReference Include="../../../src/Foundgine.Execution/Foundgine.Execution.csproj" />
    <ProjectReference Include="../../../src/Foundgine.Sql/Foundgine.Sql.csproj" />
    <ProjectReference Include="../../../src/Foundgine.Semantics/Foundgine.Semantics.csproj" />
    <ProjectReference Include="../../../src/Foundgine.MCP/Foundgine.MCP.csproj" />

    <!-- The AOT source generator: it runs over THIS project's compilation and emits
         Foundgine.Generated.GeneratedMetadata from the [FoundgineModel]/[FoundgineEntity]
         attributes in Domain/. It never required Domain to be its own assembly - an
         analyzer sees every file in whatever project it's attached to, folders included. -->
    <ProjectReference Include="../../../src/Foundgine.Aot.Generator/Foundgine.Aot.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

</Project>
