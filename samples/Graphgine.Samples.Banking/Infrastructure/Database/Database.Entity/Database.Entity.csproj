<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <OutputType>Library</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableEntityForeignKeyEmitter>true</EnableEntityForeignKeyEmitter>
    </PropertyGroup>

    <ItemGroup>

        <ProjectReference Include="..\..\..\..\..\src\Graphgine\Graphgine.csproj" />

        <ProjectReference Include="..\..\..\..\..\src\Graphgine.SourceGenerators\Graphgine.SourceGenerators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <ProjectReference Include="..\Database.Graph\Database.Graph.csproj" />

    </ItemGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="EnableEntityForeignKeyEmitter" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    </ItemGroup>

</Project>
