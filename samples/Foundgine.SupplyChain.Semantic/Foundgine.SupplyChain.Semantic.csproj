<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- These directories contain separate projects. Keep their source
         files out of the main sample assembly. -->
    <Compile Remove="Tests/**/*.cs" />
    <None Remove="Tests/**/*.cs" />

    <Compile Remove="Api/Mcp/**/*.cs" />
    <None Remove="Api/Mcp/**/*.cs" />

    <Compile Remove="McpClient/**/*.cs" />
    <None Remove="McpClient/**/*.cs" />

    <Compile Remove="Benchmarks/**/*.cs" />
    <None Remove="Benchmarks/**/*.cs" />

    <ProjectReference Include="../../src/Foundgine.Abstractions/Foundgine.Abstractions.csproj" />
    <ProjectReference Include="../../src/Foundgine.Aot/Foundgine.Aot.csproj" />
    <ProjectReference Include="../../src/Foundgine.Metadata/Foundgine.Metadata.csproj" />

    <ProjectReference Include="../../src/Foundgine.Aot.Generator/Foundgine.Aot.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />

    <ProjectReference Include="../../src/Foundgine.Semantics/Foundgine.Semantics.csproj" />
  </ItemGroup>

</Project>
