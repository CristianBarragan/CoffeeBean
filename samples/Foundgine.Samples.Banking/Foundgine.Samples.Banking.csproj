<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <RootNamespace>Foundgine.Samples.Banking</RootNamespace>
        <Description>
            The canonical Foundgine proof: Domain -&gt; Metadata -&gt; Dynamic
            Planner -&gt; QueryPlan -&gt; ProviderPlan -&gt; SQL -&gt; real database -&gt;
            Result for Customer -&gt; Account -&gt; Transaction, with no GraphQL,
            no HotChocolate, and no Graphgine.* project anywhere in this
            project's dependency graph. Compare to
            archive/samples/Graphgine.Samples.Banking, the same domain idea
            fronted by GraphQL, moved out of the active tree so this sample is
            the single canonical proof domain.
        </Description>
    </PropertyGroup>

    <!--
      Deliberately references only the platform, never Graphgine or anything
      GraphQL-shaped. If a future change makes that untrue, ArchitectureTests.cs
      won't catch it (samples/ isn't in its scope), but it would defeat the
      entire point of this sample existing.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\Foundgine.Metadata\Foundgine.Metadata.csproj" />
        <ProjectReference Include="..\..\src\Foundgine.Builders\Foundgine.Builders.csproj" />
        <ProjectReference Include="..\..\src\Foundgine.Planning\Foundgine.Planning.csproj" />
        <ProjectReference Include="..\..\src\Foundgine.Execution.Contracts\Foundgine.Execution.Contracts.csproj" />
        <ProjectReference Include="..\..\src\Foundgine.Providers\Foundgine.Providers.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    </ItemGroup>

</Project>
