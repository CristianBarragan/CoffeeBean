<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <OutputType>Library</OutputType>
        <PlatformTarget>x64</PlatformTarget>

        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <RootNamespace>Domain.Shared</RootNamespace>

        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>

        <IsMappingRoot>true</IsMappingRoot>
    </PropertyGroup>


    <!-- Makes MSBuild property available to the Roslyn generator -->
    <ItemGroup>
        <CompilerVisibleProperty Include="IsMappingRoot" />
    </ItemGroup>


    <ItemGroup>
        <ProjectReference Include="..\CoffeeBeanery.Mapping.Generators\CoffeeBeanery.Mapping.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />

        <ProjectReference Include="..\CoffeeBeanery.Runtime\CoffeeBeanery.Runtime.csproj" />
    </ItemGroup>


    <ItemGroup>
        <PackageReference Include="AWSSDK.Core" Version="4.0.0.19" />
        <PackageReference Include="AWSSDK.RDS" Version="4.0.4.4" />
        <PackageReference Include="AWSSDK.SecurityToken" Version="4.0.1.7" />

        <PackageReference Include="Dapper.Contrib" Version="2.0.78" />

        <PackageReference Include="FasterKv.Cache.Core" Version="1.0.2" />


        <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.0" />

        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.7">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.7" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.7" />
        <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="9.0.7" />
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.7" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.7" />

        <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.7" />

        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    </ItemGroup>


    <!-- Projects containing model/entity types -->
    <ItemGroup>
        <ProjectReference Include="..\..\Infrastructure\Database\Database.Entity.Banking\Database.Entity.Banking.csproj" />
        <ProjectReference Include="..\..\Infrastructure\Database\Database.Graph.Banking\Database.Graph.Banking.csproj" />
        <ProjectReference Include="..\Domain.Model\Domain.Model.csproj" />
    </ItemGroup>

</Project>