<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Description>The pipeline engine: mutation plans and the concrete execution providers (SQL, cache, graph) that implement Foundgine.Execution.Contracts.IExecutionProvider to carry a ProviderPlan to a result. This is what "Foundgine.Core" means in the dependency-direction diagram — everything Graphgine ultimately compiles down to and runs through. Execution context/options/results and ProviderPlan itself live one layer down, in Foundgine.Execution.Contracts, so a provider implementation never needs Core to exist.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Foundgine.Builders\Foundgine.Builders.csproj" />
        <ProjectReference Include="..\Foundgine.Diagnostics\Foundgine.Diagnostics.csproj" />
        <ProjectReference Include="..\Foundgine.Execution.Contracts\Foundgine.Execution.Contracts.csproj" />
        <ProjectReference Include="..\Foundgine.Metadata\Foundgine.Metadata.csproj" />
    </ItemGroup>

    <!--
      The Sql/Cache/Graph execution providers under Provider/ are currently thin
      skeletons (see file comments) — add the matching PackageReference (Npgsql,
      FasterKv.Cache.Core, etc.) here once each provider grows a real implementation.
    -->

</Project>
