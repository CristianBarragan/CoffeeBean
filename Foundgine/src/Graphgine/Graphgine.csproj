<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Description>Graphgine: the GraphQL engine built on the Foundgine platform. Contains GraphQL-specific mapping (entity/model binding), SQL-shaped graph structures (nodes, edges, pagination), and the execution/filtering/paging compilers that turn a GraphQL selection into a Foundgine query plan. Knows nothing about any particular GraphQL server — see Graphgine.HotChocolate for that.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.7" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
        <PackageReference Include="morelinq" Version="4.4.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Foundgine.Core\Foundgine.Core.csproj" />
        <ProjectReference Include="..\Foundgine.Foundation\Foundgine.Foundation.csproj" />
        <ProjectReference Include="..\Foundgine.Metadata\Foundgine.Metadata.csproj" />
        <ProjectReference Include="..\Foundgine.Diagnostics\Foundgine.Diagnostics.csproj" />
    </ItemGroup>

</Project>
