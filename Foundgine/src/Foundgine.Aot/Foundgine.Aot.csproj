<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>

    <PackageId>Foundgine.Aot</PackageId>
    <RootNamespace>Foundgine.Aot</RootNamespace>
    <AssemblyName>Foundgine.Aot</AssemblyName>

    <Description>
      AOT metadata attributes and runtime support for generated Foundgine metadata.
    </Description>

    <PackageTags>aot;source-generator;metadata;native-aot;semantic-execution;dotnet</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReleaseNotes>1.1.0: Additive release with the host-owned security execution-context provider contract. GraphQL secure query execution is provided by Foundgine.GraphQL.HotChocolate.Execution. The Supply Chain reference sample is source-integrated against this release line. 1.0.0: Semver stability declaration only; no runtime capability change since 0.5.0. 0.5.0: Packaging/documentation cleanup only; no AOT runtime capability change. 0.3.0: AOT metadata generation became part of the validated release surface; this package bundles the required metadata runtime and generator assets.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Include custom package assets -->
    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);
      IncludeFoundginePackageContent
    </TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>

    <!-- Public API -->
    <ProjectReference
            Include="../Foundgine.Abstractions/Foundgine.Abstractions.csproj" />

    <!-- AOT field handles provide semantic fluent operations over the core semantic model. -->
    <ProjectReference
            Include="../Foundgine.Semantics/Foundgine.Semantics.csproj" />

    <!--
      Required runtime implementation.

      It is intentionally not exposed as a NuGet dependency because
      Foundgine.Aot packages the runtime assembly directly.
    -->
    <ProjectReference
            Include="../Foundgine.Metadata/Foundgine.Metadata.csproj"
            ReferenceOutputAssembly="true"
            PrivateAssets="all" />

    <!-- Build the generator as part of the project graph. It is consumed only as an analyzer. -->
    <ProjectReference
            Include="../Foundgine.Aot.Generator/Foundgine.Aot.Generator.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
            PrivateAssets="all" />

  </ItemGroup>

  <ItemGroup>

    <!-- Package documentation -->
    <None
            Include="../../README.md"
            Pack="true"
            PackagePath="README.md" />

    <None
            Include="../../LICENSE"
            Pack="true"
            PackagePath="LICENSE/LICENSE" />

  </ItemGroup>

  <!-- The generator is a project dependency, so a normal Build produces it before Pack. -->

  <Target
          Name="IncludeFoundginePackageContent"
          DependsOnTargets="Build">

    <ItemGroup>

      <!--
        Foundgine.Metadata is bundled into Foundgine.Aot as a runtime
        library.
      -->
      <TfmSpecificPackageFile
              Include="$(TargetDir)Foundgine.Metadata.dll"
              Condition="Exists('$(TargetDir)Foundgine.Metadata.dll')"
              PackagePath="lib/$(TargetFramework)" />

      <!--
        Source generator.
      -->
      <TfmSpecificPackageFile
              Include="$(MSBuildProjectDirectory)/../Foundgine.Aot.Generator/bin/$(Configuration)/netstandard2.0/Foundgine.Aot.Generator.dll"
              Condition="Exists('$(MSBuildProjectDirectory)/../Foundgine.Aot.Generator/bin/$(Configuration)/netstandard2.0/Foundgine.Aot.Generator.dll')"
              PackagePath="analyzers/dotnet/cs" />

    </ItemGroup>

  </Target>

</Project>