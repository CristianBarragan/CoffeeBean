<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Foundgine.InMemory</PackageId>
    <Description>In-memory execution provider for Foundgine testing and development.</Description>
    <PackageTags>in-memory;testing;execution-provider;semantic-execution;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>Foundgine.InMemory</RootNamespace>
    <AssemblyName>Foundgine.InMemory</AssemblyName>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageReleaseNotes>1.1.0: Additive release with the host-owned security execution-context provider contract. GraphQL secure query execution is provided by Foundgine.GraphQL.HotChocolate.Execution. The Supply Chain reference sample is source-integrated against this release line. 1.0.0: Semver stability declaration only; no runtime capability change since 0.5.0. 0.5.0: Packaging/documentation cleanup only; no InMemory provider runtime capability change. 0.3.0: InMemory execution became part of the validated provider execution surface.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="LICENSE" />
    <ProjectReference Include="../Foundgine.Execution/Foundgine.Execution.csproj" />
    <ProjectReference Include="../Foundgine.Metadata/Foundgine.Metadata.csproj" />
    <ProjectReference Include="../Foundgine.Planning/Foundgine.Planning.csproj" />
    <ProjectReference Include="../Foundgine.Semantics/Foundgine.Semantics.csproj" />
  </ItemGroup>
</Project>
