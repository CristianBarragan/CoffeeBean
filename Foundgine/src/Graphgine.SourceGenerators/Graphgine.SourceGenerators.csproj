<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>

        <!-- Roslyn generator settings -->
        <IsRoslynComponent>true</IsRoslynComponent>
        <IncludeBuildOutput>true</IncludeBuildOutput>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

        <!-- Debug generated output while developing -->
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
        <WarningsAsErrors>IDE0051;IDE0052</WarningsAsErrors>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <RootNamespace>Graphgine.SourceGenerators</RootNamespace>
        <Description>Roslyn source generator that reads mapping classes and emits the strongly-typed EntityId/FieldId/ColumnId metadata (Foundgine.Metadata) and mutation/query materializers a mapping author would otherwise hand-write. Generates code; see Graphgine.Analyzers for diagnostics-only analyzers.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.14.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>

    <!-- Put generator assembly in analyzer folder when packed -->
    <ItemGroup>
        <None Include="$(OutputPath)$(AssemblyName).dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="false" />
    </ItemGroup>

    <!--
      Note: a source generator can't ProjectReference a normal library and still run
      in the consumer's compilation (it must stay netstandard2.0 + Roslyn-only), so
      unlike every other Graphgine.* project this one does NOT reference Graphgine or
      Foundgine.* directly. It emits *code* that references Foundgine.Metadata types
      by name (see Emit/IdEmitter.cs) into the consuming project instead.
    -->

</Project>
