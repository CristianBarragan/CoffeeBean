<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Description>PostgreSQL/Npgsql-specific infrastructure (connection setup for Apache AGE, transaction/unit-of-work) split out of Graphgine so the core GraphQL engine project no longer has a hard package dependency on a specific database driver. Not yet referenced by anything in this solution -- Graphgine's SQL compiler (PostgresSqlWriter) doesn't touch a live connection, and nothing currently wires IUnitOfWorkContext up via DI (see Api.Banking/Program.cs, which opens its own NpgsqlConnection directly instead). This project exists so that work has a real home when it happens, rather than living inside Graphgine.csproj where it forced an EF Core + Npgsql package dependency onto a project that otherwise never touches either.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Npgsql" Version="9.0.4" />
    </ItemGroup>

</Project>
