@startuml agent-tool-boundary
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #55506A
skinparam componentStyle rectangle
skinparam rectangle {
  FontSize 15
  FontColor #17132B
  BorderColor #55506A
  BackgroundColor #FFFFFF
}

rectangle "AI application / agent" as Agent #F3EFFF {
  rectangle "Model / agent loop" as Model
  rectangle "Capability discovery" as Discovery
  rectangle "Structured intent" as Intent
  Model -down-> Discovery
  Discovery -down-> Intent
}

rectangle "Foundgine semantic execution boundary" as F #EEF9EF {
  rectangle "1 · Resolve" as Resolve
  rectangle "2 · Validate" as Validate
  rectangle "3 · Authorize" as Authorize
  rectangle "4 · Semantic plan + authorization binding" as Plan
  rectangle "5 · ExecutionIR" as IR
  rectangle "6 · Provider plan + final execution gate" as Gate
  Resolve -right-> Validate
  Validate -right-> Authorize
  Authorize -down-> Plan
  Plan -down-> IR
  IR -down-> Gate
}

rectangle "Physical infrastructure" as Provider #EDF9F3 {
  rectangle "SQL / PostgreSQL" as Sql
  rectangle "InMemory / other providers" as Other
  rectangle "Result + evidence" as Evidence
}

rectangle "Host-owned authority
Authentication · actor identity · tenant context · secrets · application policy" as Host #FFF5E8

Intent -right-> F
Gate -right-> Provider
F -down-> Host

note right of Discovery
Discovery is descriptive.
It never grants authority.
end note
note left of Provider
Providers execute the
already-authorized artifact.
end note
@enduml
