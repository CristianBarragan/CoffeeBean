@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #55506A
skinparam componentStyle rectangle
skinparam rectangle {
  FontSize 15
  FontColor #17132B
  BorderColor #55506A
  BackgroundColor #FFFFFF
}
rectangle "AI Agent" as Agent #F3EFFF
rectangle "Capability A\nCapability B\nCapability C\n..." as Tools #FFFFFF
rectangle "Foundgine\nResolve → Validate → Authorize\n→ Plan → Execute" as F #EEF9EF
rectangle "Provider\nSQL / InMemory / ..." as P #EDF9F3
Agent --> Tools
Tools --> F : structured intent
F --> P : authorized execution
note right of Tools
Tools do not become independent
authorization boundaries.
end note
@enduml
