<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Description>Milestone 1 -- the protocol-neutral semantic application model built on top of Foundgine.Metadata: Entity/Identity/Field/Relationship/SearchCapability/Action/Policy descriptors. This is what Milestone 2 (resolution), Milestone 3 (read intent), Milestone 4 (domain actions) and Milestone 5 (policy) reason about -- none of it knows SQL, GraphQL, or any transport exists.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Foundgine.Metadata\Foundgine.Metadata.csproj" />
    </ItemGroup>

</Project>
