<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Description>Mutation planning: MutationOperation (EntityMutation/GraphMutation/RelationshipMutation) and MutationPlan, the mutation-side counterpart to Foundgine.Builders' QueryPlan. A mutation isn't a query, so it gets its own plan model rather than being forced into QueryPlan. Depends only on Foundgine.Metadata; has no knowledge of how a plan gets executed (see Foundgine.Providers/Foundgine.Execution.Contracts for that).</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Foundgine.Metadata\Foundgine.Metadata.csproj" />
    </ItemGroup>

</Project>
