<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Foundgine.GraphQL.HotChocolate</RootNamespace>
    <AssemblyName>Foundgine.GraphQL.HotChocolate</AssemblyName>
    <IsPackable>true</IsPackable>
    <Description>Thin Hot Chocolate adapter for Foundgine. Converts GraphQL selections into provider-neutral SemanticRequest objects.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HotChocolate.Language" Version="15.1.16" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Foundgine.Semantics/Foundgine.Semantics.csproj" />
    <ProjectReference Include="../Foundgine.Metadata/Foundgine.Metadata.csproj" />
  </ItemGroup>
</Project>
