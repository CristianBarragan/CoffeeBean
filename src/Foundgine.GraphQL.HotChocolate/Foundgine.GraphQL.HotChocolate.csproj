<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Foundgine.GraphQL.HotChocolate</PackageId>
    <Description>Hot Chocolate adapter that converts GraphQL selections into Foundgine semantic requests.</Description>
    <PackageTags>graphql;hotchocolate;semantic-execution;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>Foundgine.GraphQL.HotChocolate</RootNamespace>
    <AssemblyName>Foundgine.GraphQL.HotChocolate</AssemblyName>
    <IsPackable>true</IsPackable>
    <TargetFramework>net9.0</TargetFramework>
    <PackageReleaseNotes>1.1.0: Additive release with the host-owned security execution-context provider contract. GraphQL secure query execution is provided by Foundgine.GraphQL.HotChocolate.Execution. The Supply Chain reference sample is source-integrated against this release line. 1.0.0: Semver stability declaration only; no runtime capability change since 0.5.0. 0.5.0: Packaging/documentation cleanup only; no GraphQL adapter runtime capability change. 0.3.0: Hot Chocolate GraphQL adapter became part of the validated release surface for translating GraphQL selections into Foundgine semantic requests.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="LICENSE" />
    <PackageReference Include="HotChocolate.Language" Version="16.6.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Foundgine.Semantics/Foundgine.Semantics.csproj" />
    <ProjectReference Include="../Foundgine.Metadata/Foundgine.Metadata.csproj" />
    <ProjectReference Include="../Foundgine/Foundgine.csproj" />
  </ItemGroup>
</Project>
