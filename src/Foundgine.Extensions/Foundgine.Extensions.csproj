<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Foundgine.Extensions</PackageId>
    <Description>Foundgine.Extensions contains optional framework integrations for Foundgine v2. The current package provides the Hot Chocolate GraphQL integration that maps GraphQL operations into Foundgine semantic intent and connects GraphQL applications to the Foundgine runtime model. It does not replace the Foundgine execution/runtime layer and does not provide storage providers. Consumers are expected to have Foundgine.Core and Foundgine.Runtime installed and to configure their GraphQL server and semantic model; concrete provider execution is supplied separately.</Description>
    <PackageTags>graphql;hotchocolate;extensions;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>Foundgine.Extensions</RootNamespace>
    <AssemblyName>Foundgine.Extensions</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageReleaseNotes>2.0.0: v2 package restructuring. Consolidates the former Foundgine.GraphQL.HotChocolate, Foundgine.GraphQL.HotChocolate.Execution, Foundgine.GraphQL.HotChocolate.Mutations, and Foundgine.GraphQL.HotChocolate.MutationExecution packages.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" Condition="Exists('README.md')" />
    <None Include="../../LICENSE" Pack="true" PackagePath="LICENSE" />
    <ProjectReference Include="../Foundgine.Core/Foundgine.Core.csproj" />
    <ProjectReference Include="../Foundgine.Runtime/Foundgine.Runtime.csproj" />
    <PackageReference Include="HotChocolate.Language" Version="16.6.2" />
  </ItemGroup>
</Project>
