<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Description>Foundational primitives (Guard, Result, Optional, ValueList) and the generic CQRS contracts/dispatchers (ICommand, IQuery, CommandDispatcher, QueryDispatcher). Protocol- and database-agnostic; depends only on Foundgine.Abstractions. The Postgres-backed UnitOfWork/UnitOfWorkContext that used to live here required Npgsql, so they moved to Graphgine.Sql instead — Foundation itself has no database dependency.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.7" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Foundgine.Abstractions\Foundgine.Abstractions.csproj" />
    </ItemGroup>

</Project>
