<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Foundgine.Metadata</PackageId>
    <Description>Semantic metadata model and runtime metadata registry for Foundgine.</Description>
    <PackageTags>metadata;semantic-model;schema;semantic-execution;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>Foundgine.Metadata</RootNamespace>
    <AssemblyName>Foundgine.Metadata</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageReleaseNotes>0.5.0: Packaging/documentation cleanup only; no metadata-model runtime capability change. 0.3.0: Metadata and semantic modeling became part of the validated semantic execution release surface. AOT metadata support builds on this package.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="LICENSE" />
    <ProjectReference Include="../Foundgine.Abstractions/Foundgine.Abstractions.csproj" />
  </ItemGroup>
</Project>
