<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Foundgine.Aot</PackageId>
    <Description>AOT metadata attributes and runtime support for generated Foundgine metadata.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>Foundgine.Aot</RootNamespace>
    <AssemblyName>Foundgine.Aot</AssemblyName>
    <IsPackable>true</IsPackable>

    <!-- Register custom target to safely include extra assemblies in the nupkg -->
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeExtraPackageContent</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="LICENSE" />

    <ProjectReference Include="../Foundgine.Abstractions/Foundgine.Abstractions.csproj" />

    <!-- 
      Package Foundgine.Metadata inside this package without declaring it as a NuGet dependency.
      Setting PrivateAssets="all" avoids putting it in the nuspec <dependencies> section.
    -->
    <ProjectReference Include="../Foundgine.Metadata/Foundgine.Metadata.csproj" PrivateAssets="all" />

    <!-- Roslyn Source Generator reference -->
    <ProjectReference
            Include="../Foundgine.Aot.Generator/Foundgine.Aot.Generator.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
            PrivateAssets="all" />
  </ItemGroup>

  <Target Name="IncludeExtraPackageContent">
    <ItemGroup>
      <!-- Pack Foundgine.Metadata.dll into lib/net9.0 -->
      <TfmSpecificPackageFile Include="$(TargetDir)Foundgine.Metadata.dll">
        <PackagePath>lib/$(TargetFramework)</PackagePath>
      </TfmSpecificPackageFile>

      <!-- Pack Foundgine.Aot.Generator.dll into analyzers/dotnet/cs -->
      <TfmSpecificPackageFile Include="$(MSBuildProjectDirectory)/../Foundgine.Aot.Generator/bin/$(Configuration)/netstandard2.0/Foundgine.Aot.Generator.dll">
        <PackagePath>analyzers/dotnet/cs</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>