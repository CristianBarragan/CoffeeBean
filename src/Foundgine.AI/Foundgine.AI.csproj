<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <PackageId>Foundgine.AI</PackageId>
    <Description>AI tool integration for Foundgine semantic execution using Microsoft.Extensions.AI.</Description>
    <PackageTags>ai;llm;microsoft-extensions-ai;ai-tools;semantic-execution;dotnet</PackageTags>
    <RootNamespace>Foundgine.AI</RootNamespace>
    <AssemblyName>Foundgine.AI</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageReleaseNotes>0.5.0: Packaging/documentation cleanup only; no AI adapter runtime capability change. Provides Microsoft.Extensions.AI integration for Foundgine semantic execution.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="LICENSE" />
    <ProjectReference Include="../Foundgine/Foundgine.csproj" />
    <ProjectReference Include="../Foundgine.Intent.Json/Foundgine.Intent.Json.csproj" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.3" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.8.3" />
  </ItemGroup>
</Project>
