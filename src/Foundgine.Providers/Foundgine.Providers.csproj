<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Description>SQL execution provider: SqlPlanCompiler (Foundgine.Builders.QueryPlan -> Foundgine.Execution.Contracts.ProviderPlan), SqlTextTranslator (ProviderPlan -> SQL text + column map), and SqlExecutionProvider (runs that SQL against SQLite and streams ExecutionRow results back). This is the only provider in the active tree — see archive/src/Foundgine.Providers.Extra for the Graph and Cache provider skeletons, which are future work until the SQL path is proven end-to-end.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Foundgine.Builders\Foundgine.Builders.csproj" />
        <ProjectReference Include="..\Foundgine.Execution.Contracts\Foundgine.Execution.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    </ItemGroup>

</Project>
