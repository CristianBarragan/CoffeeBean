<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Foundgine.GraphQL.HotChocolate.Mutations</PackageId>
    <Description>Hot Chocolate mutation adapter for Foundgine.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>Foundgine.GraphQL.HotChocolate</RootNamespace>
    <AssemblyName>Foundgine.GraphQL.HotChocolate.Mutations</AssemblyName>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="LICENSE" />
    <PackageReference Include="HotChocolate.Language" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Foundgine.Abstractions/Foundgine.Abstractions.csproj" />
    <ProjectReference Include="../Foundgine.Metadata/Foundgine.Metadata.csproj" />
    <ProjectReference Include="../Foundgine.Semantics/Foundgine.Semantics.csproj" />
    <ProjectReference Include="../Foundgine.Planning/Foundgine.Planning.csproj" />
    <ProjectReference Include="../Foundgine.Execution/Foundgine.Execution.csproj" />
    <ProjectReference Include="../Foundgine.GraphQL.HotChocolate/Foundgine.GraphQL.HotChocolate.csproj" />
  </ItemGroup>
</Project>